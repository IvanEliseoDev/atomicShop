PORT=""
DB_URI="mongodb://localhost:27107/AtomicShopDB"
JWT_SECRET=""

# NODE_ENV debe ser "production" en Render para que las cookies funcionen correctamente
NODE_ENV="production"

# ─── EMAIL (SMTP) ───────────────────────────────────────────────────────────
# OPCIÓN 1 — Brevo (recomendado para hosting en la nube, gratuito 300/día):
#   Registrarse en https://app.brevo.com → SMTP & API → Generar SMTP key
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="tu_correo@example.com"
SMTP_PASS="tu_smtp_key_de_brevo"
FROM_EMAIL="tu_correo@example.com"

# OPCIÓN 2 — Gmail con App Password (requiere 2FA activo en la cuenta):
#   Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tucorreo@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16 caracteres sin espacios
# FROM_EMAIL="tucorreo@gmail.com"
# ─────────────────────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME="name"
CLOUDINARY_API_KEY="key"
CLOUDINARY_API_SECRET="secret"

ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

WOMPI_GRANT_TYPE=""
WOMPI_AUDIENCE=""
WOMPI_CLIENT_ID=""
WOMPI_CLIENT_SECRET=""
